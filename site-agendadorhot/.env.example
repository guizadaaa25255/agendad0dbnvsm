# Credenciais da API do Telegram (obtenha em https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Chave Fernet de 32 bytes gerada para criptografar as sessões no SQLite
# Pode ser gerada com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Configurações da Aplicação
APP_ENV=production
DATABASE_URL=sqlite:///./data/scheduler.db
TIMEZONE=America/Fortaleza
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
PORT=8000
HOST=0.0.0.0
